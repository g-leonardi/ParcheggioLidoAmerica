# Copia in .env e adatta i valori
PORT=3000
DB_PATH=./data/parcheggio.db
SEED_PATH=./data/cabine.json

# --- Autenticazione ---
# Password del super user (necessaria in produzione per approvare i dispositivi).
SUPERUSER_PASSWORD=cambia-questa-password
# Segreto per firmare i token del super user (stringa lunga e casuale).
AUTH_SECRET=cambia-questo-segreto-lungo-e-casuale
# Bypass in sviluppo/test: 1 = nessun controllo, dispositivi auto-approvati. NON usare in produzione.
AUTH_DEV_BYPASS=0

# --- ALPR (Plate Recognizer Snapshot Cloud) ---
# Token API. Lasciare vuoto in dev: l'endpoint risponde alpr_non_configurato.
ALPR_API_KEY=
# Endpoint: usare la regione EU per conformità GDPR. Default = endpoint generico.
ALPR_URL=https://api.platerecognizer.com/v1/plate-reader/
# Hint regione targhe (it = Italia).
ALPR_REGIONS=it
# Soglia minima di confidenza (0..1). Sotto questa si forza l'inserimento manuale.
ALPR_CONFIDENCE_MIN=0.65
# Mock per sviluppo: 1 = restituisce una targa casuale dall'anagrafica senza chiamare il cloud.
ALPR_MOCK=0
